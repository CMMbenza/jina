    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f8f9fa;
            color: #333;
        }
        .hero-section {
            background: linear-gradient(135deg, #0d6efd 0%, #0a47a3 100%);
            color: white;
            padding: 80px 0;
        }
        .profile-img {
            width: 250px;
            height: 250px;
            object-fit: cover;
            border: 8px solid rgba(255, 255, 255, 0.2);
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        }
        .section-title {
            position: relative;
            margin-bottom: 40px;
            font-weight: 700;
        }
        .section-title::after {
            content: '';
            position: absolute;
            left: 0;
            bottom: -10px;
            width: 60px;
            height: 4px;
            background-color: #0d6efd;
            border-radius: 2px;
        }
        .section-title.center::after {
            left: 50%;
            transform: translateX(-50%);
        }
        .card-service {
            border: none;
            border-radius: 12px;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            background: white;
        }
        .card-service:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.08);
        }
        .icon-box {
            width: 60px;
            height: 60px;
            background-color: rgba(13, 110, 253, 0.1);
            color: #0d6efd;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            margin-bottom: 20px;
        }
        .badge-activity {
            background-color: rgba(13, 110, 253, 0.08);
            color: #0d6efd;
            border: 1px solid rgba(13, 110, 253, 0.2);
            padding: 10px 16px;
            font-size: 0.95rem;
            border-radius: 30px;
            margin: 5px;
            display: inline-block;
        }
        .catalogue-img {
            border-radius: 8px;
            transition: transform 0.3s;
            cursor: pointer;
            height: 350px;
            object-fit: cover;
        }
        .catalogue-img:hover {
            transform: scale(1.03);
        }
        .review-card {
            background: white;
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.02);
        }
        .star-rating {
            color: #ffc107;
        }
        .social-btn {
            width: 45px;
            height: 45px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: white;
            color: #0d6efd;
            margin: 0 5px;
            font-size: 18px;
            transition: all 0.3s;
            text-decoration: none;
        }
        .social-btn:hover {
            background: #ffc107;
            color: #111;
            transform: translateY(-3px);
        }
    </style>
</head>
